# SentinelOps Environment Configuration
# Copy this file to .env and fill in your values
# Usage: export $(cat .env | xargs) && uvicorn incident-normalizer.webhook_server:app --port 8000

# ── GitHub (required for GitOps PR bridge) ──────────────────────────────────────
# Create a PAT at https://github.com/settings/tokens with repo:write scope
GITHUB_TOKEN=your-github-pat-here
# Your GitHub repo in "owner/repo" format
GITHUB_REPO=MUGEN1603/sentinelops
# Base branch to open PRs against
GITHUB_BASE_BRANCH=main
# Set to "true" to auto-merge low-risk patches (requires branch protection rules)
AUTO_MERGE_LOW_RISK=false

# ── Qdrant Vector DB ────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── OPA Policy Server ───────────────────────────────────────────────────────────
OPA_URL=http://localhost:8181

# ── Ollama (LLM) ────────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen3-coder:latest

# ── Observability (port-forward before starting normalizer) ─────────────────────
# kubectl port-forward -n observability svc/kube-prometheus-prometheus 9090
PROMETHEUS_URL=http://localhost:9090
# kubectl port-forward -n observability svc/loki 3100
LOKI_URL=http://localhost:3100

# ── LangGraph Checkpointer ──────────────────────────────────────────────────────
SENTINELOPS_CHECKPOINT_DB=checkpoints.db

# ── Pipeline concurrency ────────────────────────────────────────────────────────
PIPELINE_WORKERS=2
